import "std.array_basic";
import "std.numeric_basic";
import "algorithms.search_basic";
import "data_structures.ring_basic";

func main() {
    var values = array_alloc(6);
    array_set(values, 0, 8);
    array_set(values, 1, 3);
    array_set(values, 2, 8);
    array_set(values, 3, 1);
    array_set(values, 4, 5);
    array_set(values, 5, 8);

    println(array_min(values, 6));
    println(array_count(values, 6, 8));
    sort_selection(values, 6);
    println(search_binary(values, 6, 8));
    println(numeric_gcd(84, 30));
    println(numeric_lerp(10, 20, 1, 2));

    var queue = ring_alloc(3);
    ring_push(queue, 3, 0, 0, 11);
    ring_push(queue, 3, 0, 1, 22);
    println(ring_peek(queue, 3, 0, 2, 1));
    ring_free(queue);
    array_free(values);
}