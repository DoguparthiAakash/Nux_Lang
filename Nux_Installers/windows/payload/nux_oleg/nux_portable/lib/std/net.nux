        # Native stub: syscall to connect to remote IP and Port
        
        return sock;
    }

    # Listen on a TCP port
    func tcp_listen(port_num: int) -> Socket {
        var sock = alloc(32);
        
        # Native stub: bind and listen
        
        return sock;
    }

    # Accept an incoming connection
    func accept(server_sock: Socket) -> Socket {
        var client_sock = alloc(32);
        
        # Native stub: accept syscall
        
        return client_sock;
    }

    # Close a socket connection
    func close(sock: Socket) {
        if (sock != 0) {
            free(sock);
        }
    }

    # Send data over socket
    func send(sock: Socket, buf: int, len: int) -> int {
