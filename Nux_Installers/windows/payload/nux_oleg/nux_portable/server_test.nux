func main() {
    println("Starting Nux HTTP Server on port 8081...");
    var port = 8081;
    
    while (true) {
        # http_listen blocks and returns a request ID when a request comes in
        var req_id = http_listen(port);
        
        if (req_id != 0) {
            println("Received request: ");
            println(req_id);
            
            var response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<html><body><h1>Welcome to Nux Language Server</h1><p>Running directly inside the Nux VM!</p></body></html>";
            
            # Send the response
            http_respond(req_id, response);
            println("Response sent.");
        }
    }
}
main();
