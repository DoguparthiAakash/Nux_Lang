class TcpServer {
    var id ;
    
    func init(self, port) {
        self.id = net_listen(port);
    }
    
    func accept(self) {
        return net_accept(self.id);
    }
    
    func close(self) {
        net_close(self.id);
    }
}

class TcpClient {
    var id ;
    
    func init(self, client_id) {
        self.id = client_id;
    }
    
    func read(self) {
        return net_read(self.id);
    }
    
    func write(self, data) {
        return net_write(self.id, data);
    }
    
    func close(self) {
        net_close(self.id);
    }
}

class TcpTlsServer {
    var id ;
    
    func init(self, port, cert_file, key_file) {
        self.id = net_listen_tls(port, cert_file, key_file);
    }
    
    func accept(self) {
        return net_accept(self.id);
    }
    
    func close(self) {
    func close(self) {
        net_close(self.id);
    }
}

# Advanced Protocol Wrappers

class HttpClient {
    var client;

    func init(self, url) {
        # Assuming net_connect resolves host and returns a client id
        var id = net_connect(url, 80);
        self.client = new TcpClient();
        self.client.init(id);
    }

    func get(self, path, buffer_addr) {
        # Construct raw HTTP GET request string
        # format: GET {path} HTTP/1.1\r\n\r\n
        # (In a real app, we'd use strcat from string.nux)
        var req = "GET ";
        self.client.write(req);
        self.client.write(path);
        self.client.write(" HTTP/1.1\r\n\r\n");
        
        # We would read until end of stream into buffer_addr
        var res = self.client.read();
        poke(buffer_addr, res); # MVP: just write raw ptr/val 
        return 1;
    }

    func close(self) {
        self.client.close();
    }
}
