# alloc.nux - Nux Advanced Memory Allocator (Free-List Heap)
# Replaces the legacy bump allocator.

# @memory_limit(8000000)
# @priority(50)

# Addr 100: heap_ptr (current top of unallocated memory)
# Addr 108: heap_end (max boundary)
# Addr 116: free_list_head (pointer to first freed block)

func alloc_init(heap_base, heap_size) {
    poke(100, heap_base);
    poke(108, heap_base + heap_size);
    poke(116, 0); # No free blocks initially
    return 0;
}

# Block Header Structure (3 words / 24 bytes assuming 64-bit words, but we'll use 3 offsets):
# [0]: size
# [1]: is_free (1 = true, 0 = false)
# [2]: next_block (ptr)

func malloc(size) {
    var free_head = peek(116);
    var curr = free_head;
    var prev = 0;

    # 1. Search free list for a block large enough
    while (curr != 0) {
        var b_size = peek(curr);
        var b_free = peek(curr + 1);
        
        if (b_free == 1) {
            if (b_size >= size) {
                # Found a suitable block
                poke(curr + 1, 0); # Mark as used
                return curr + 3; # Return address after header
            }
        }
        prev = curr;
        curr = peek(curr + 2);
    }

    # 2. If no free block found, expand the heap (Bump)
    var top = peek(100);
    var end = peek(108);
    var total_size = size + 3; # Space + Header

    if (top + total_size > end) {
        return 0 - 1; # Out of Memory!
    }

    # Write Header
    poke(top, size);       # Size
    poke(top + 1, 0);      # Used
    poke(top + 2, 0);      # Next block (0)

    # If there's a previous block in the chain, link it?
    # Actually, new blocks aren't in the free list until freed.
    
    # Update heap top
    poke(100, top + total_size);

    return top + 3; # Return address after header
}

func mfree(ptr) {
    if (ptr <= 0) { return 0; }
    
    var header_addr = ptr - 3;
    poke(header_addr + 1, 1); # Mark as free

    # Prepend to free list
    var old_head = peek(116);
    poke(header_addr + 2, old_head); # Link next to old head
    poke(116, header_addr);          # Update head to this block

    return 1;
}

func alloc_free_bytes() {
    return peek(108) - peek(100);
}
