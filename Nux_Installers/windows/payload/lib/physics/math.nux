# physics::math
# Math structures for physics simulations (Vectors, Matrices)

import std::math;

class Vec2 {
    var x: f32;
    var y: f32;
    
    func init(x: f32, y: f32) {
        this.x = x;
        this.y = y;
    }
    
    func add(other: Vec2) -> Vec2 {
        var v = new Vec2();
        v.init(this.x + other.x, this.y + other.y);
        return v;
    }
    
    func sub(other: Vec2) -> Vec2 {
        var v = new Vec2();
        v.init(this.x - other.x, this.y - other.y);
        return v;
    }
    
    func mul(scalar: f32) -> Vec2 {
        var v = new Vec2();
        v.init(this.x * scalar, this.y * scalar);
        return v;
    }
    
    func dot(other: Vec2) -> f32 {
        return (this.x * other.x) + (this.y * other.y);
    }
    
    func length() -> f32 {
        # Pseudo-code, requires sqrt from std::math
        # return std::math::sqrt(this.dot(this));
        return 0.0;
    }
}
