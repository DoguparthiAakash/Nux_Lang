# The @[gpu_kernel] macro signals to the compiler that this function
# must be compiled by the PTX backend, not the standard CPU backend.
# 
# Example usage:
# @[gpu_kernel]
# func vector_add(a_ptr, b_ptr, c_ptr) {
#     var idx = thread_idx_x();
#     c_ptr[idx] = a_ptr[idx] + b_ptr[idx];
# }

