# Supports automatic broadcasting and zero-copy slicing.
# Uses Native FFI to bind to OpenBLAS or CUDA under the hood!

class Tensor {
    var shape;
    var data_ptr; # Backed by raw, safe memory (0-byte heap capable)
    
    func init(shape_list) {
