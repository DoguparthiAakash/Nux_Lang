class SGD {
    var parameters: List; # list of Tensors
    var lr: f32;
    
    func init(params: List, learning_rate: f32) {
        this.parameters = params;
        this.lr = learning_rate;
    }
    
    func step() {
        var num_params = this.parameters.len();
        var i = 0;
        
        while (i < num_params) {
            var param = this.parameters.get(i); # typeof Tensor
            if (param.requires_grad) {
                # Update rule: param = param - lr * grad
                
                # In actual impl we'd dispatch a gpu kernel to do this element-wise subtraction
                # e.g., gpu::sgd_step(param.data, param.grad, this.lr, param.size)
                
                # Dummy code
                if (param.device == 1) {
                    # gpu::sgd_step_cuda(...)
                } else {
                    # cpu loop
                }
            }
            i += 1;
        }
    }
    
    func zero_grad() {
        var num_params = this.parameters.len();
        var i = 0;
        
        while (i < num_params) {
            var param = this.parameters.get(i);
            if (param.requires_grad) {
                # gpu::memset(param.grad, 0, param.size * 4);
            }
            i += 1;
        }
    }
}

class Adam {
    var parameters: List;
    var lr: f32;
    var beta1: f32;
    var beta2: f32;
    var eps: f32;
    
    var m: List; # first moment vector
    var v: List; # second moment vector
    var t: u32;  # timestep
    
    func init(params: List, learning_rate: f32) {
        this.parameters = params;
        this.lr = learning_rate;
        this.beta1 = 0.9;
        this.beta2 = 0.999;
        this.eps = 0.00000001;
        this.t = 0;
        
        this.m = new List();
        this.m.init();
        this.v = new List();
        this.v.init();
        
        var num_params = this.parameters.len();
        var i = 0;
        while (i < num_params) {
            var param = this.parameters.get(i);
            
            # allocate m and v tensors of same shape
            # var m_t = new Tensor(...)
            # this.m.append(m_t)
            # var v_t = new Tensor(...)
            # this.v.append(v_t)
            
            i += 1;
        }
    }
    
    func step() {
        this.t += 1;
        var num_params = this.parameters.len();
        var i = 0;
        
        while (i < num_params) {
            var param = this.parameters.get(i);
            if (param.requires_grad) {
                # m_t = beta1 * m_{t-1} + (1 - beta1) * g_t
                # v_t = beta2 * v_{t-1} + (1 - beta2) * g_t^2
                # param = param - lr * m_t / (sqrt(v_t) + eps)
                
                # Handled via gpu::adam_step(...)
            }
            i += 1;
        }
    }
    
    func zero_grad() {
        var num_params = this.parameters.len();
        var i = 0;
        while (i < num_params) {
            var param = this.parameters.get(i);
            if (param.requires_grad) {
                # memset 0
            }
            i += 1;
        }
    }
}
