# Nux Driver and Query Engine
# Orchestrates the compiler pipeline using on-demand, memoized queries.

class CompileContext {
    var source_files;
    var diagnostics;
    var query_cache;

    func init() {
        this.source_files = new Map();
        this.source_files.init();
        
        # Load the diagnostics engine (assumes nux_diagnostics/diagnostics.nux is linked)
        this.diagnostics = new DiagnosticEngine();
        this.diagnostics.init();
        
        this.query_cache = new Map();
        this.query_cache.init();
    }

    func add_source_file(file_id, content) {
        this.source_files.put(file_id, content);
    }

    # -- Query Methods --
    
    func compile(source_text, execution_mode) {
        var ast = this.queries.get_ast(this, source_text);
        
        # Check for force_native attribute
        if (execution_mode == "jit" && ast.has_attribute("force_native")) {
            this.diagnostics.emit_error("Module is marked @[force_native] but compiled for JIT VM. Use 'nux build --native'.");
            return "Compilation failed.";
        }
        
        var rst = this.queries.get_rst(this, ast);
        var tst = this.queries.get_tst(this, rst);
        var cir = this.queries.get_cir(this, tst);
        var borrowck_passed = this.queries.get_borrowck(this, cir);
        
        if (borrowck_passed) {
            if (execution_mode == "native") {
                var backend = new CodegenBackend();
                backend.init("native");
                var assembly = backend.generate(cir);
                this.link_native_objects(assembly);
                return assembly;
            } else if (execution_mode == "jit") {
                # VM Path
                var backend = new CodegenBackend();
                backend.init("nrbc"); # Nux Register Bytecode
                var bytecode = backend.generate(cir);
                return bytecode;
            }
        } else {
            return "Compilation failed due to borrow checker errors.";
        }
    }
    
    func link_native_objects(nux_assembly) {
        # 1. Output nux_assembly to output.s
        # 2. Invoke 'clang' or 'gcc' to assemble output.s into output.o
        # 3. Read extra native objects passed via CLI flags (e.g. `nux build --native src/stdlib.c`)
        # 4. Invoke system linker: `lld-link` or `ld` merging output.o and stdlib.o into libnux_std.so or std.dll
        # This completely bridges Nux to C!
    }

    func get_tokens(file_id) {
        var cache_key = "tokens_" + file_id;
        var cached = this.query_cache.get(cache_key);
        if (cached != 0) {
            return cached;
        }

        var source = this.source_files.get(file_id);
        if (source == 0) {
            # emit error
            return 0;
        }

        # In real code, call nux_lex
        # var tokens = nux_lex_run(source);
        var tokens = new List();
        tokens.init();

        this.query_cache.put(cache_key, tokens);
        return tokens;
    }

    func get_ast(file_id) {
        var cache_key = "ast_" + file_id;
        var cached = this.query_cache.get(cache_key);
        if (cached != 0) {
            return cached;
        }

        var tokens = this.get_tokens(file_id);
        # var ast = nux_parse_run(tokens, this.diagnostics);
        var ast = 0; # Placeholder

        this.query_cache.put(cache_key, ast);
        return ast;
    }

    func compile_all() {
        # Entry point for the compiler driver.
        # It requests the final output, which triggers the query engine recursively.
        print("Starting compilation...");
        
        # In a real build, we iterate over all root files
        # this.get_codegen_binary(root_file_id)
        
        if (this.diagnostics.has_errors) {
            this.diagnostics.print_all();
            print("Compilation failed due to previous errors.");
            return 1;
        }
        
        print("Compilation finished successfully.");
        return 0;
    }
}
