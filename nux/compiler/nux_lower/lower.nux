# Nux Lowering (TST to CIR)
# Flattens nested expressions into basic blocks with explicit temporaries and control flow.

class CIRStatement {
    var opcode; # e.g. "Assign", "Borrow", "Deref", "Drop"
    var target; # The temporary/local being assigned to
    var operands; 
    var is_mut; # Relevant for Borrow

    func init(op, tgt) {
        this.opcode = op;
        this.target = tgt;
        this.operands = new List();
        this.operands.init();
        this.is_mut = 0;
    }
}

class CIRBasicBlock {
    var id;
    var statements;
    var terminator; # Jump, Branch, or Return
    
    func init(block_id) {
        this.id = block_id;
        this.statements = new List();
        this.statements.init();
        this.terminator = 0;
    }
    
    func add_borrow(target, source_local, is_mut) {
        var stmt = new CIRStatement();
        stmt.init("Borrow", target);
        stmt.operands.append(source_local);
        stmt.is_mut = is_mut;
        this.statements.append(stmt);
    }
    
    func add_deref(target, ptr_local) {
        var stmt = new CIRStatement();
        stmt.init("Deref", target);
        stmt.operands.append(ptr_local);
        this.statements.append(stmt);
    }
    
    func add_drop(local_id) {
        var stmt = new CIRStatement();
        stmt.init("Drop", local_id);
        this.statements.append(stmt);
    }
    
    func add_extern_call(target, function_name, args_list) {
        var stmt = new CIRStatement();
        stmt.init("ExternCall", target);
        # operand 0 is the function string, the rest are arguments
        stmt.operands.append(function_name);
        
        var iter = args_list.iterator();
        while (iter.has_next()) {
            stmt.operands.append(iter.next());
        }
        
        this.statements.append(stmt);
    }
    
    func add_intrinsic_call(target, intrinsic_name, args_list) {
        var stmt = new CIRStatement();
        stmt.init("Intrinsic", target);
        # Maps directly to a hardware instruction, e.g. "popcnt" or "memcpy"
        stmt.operands.append(intrinsic_name);
        
        var iter = args_list.iterator();
        while (iter.has_next()) {
            stmt.operands.append(iter.next());
        }
        
        this.statements.append(stmt);
    }
}

class CIRFunction {
    var def_id;
    var blocks;
    var local_decls; # Tracks all variables and temporaries

    func init(id) {
        this.def_id = id;
        this.blocks = new List();
        this.blocks.init();
        this.local_decls = new List();
        this.local_decls.init();
    }
}

class Lowering {
    var query_engine;
    var current_func;
    var block_counter;

    func init(qe) {
        this.query_engine = qe;
        this.block_counter = 0;
    }

    func new_block() {
        var b = new CIRBasicBlock();
        b.init(this.block_counter);
        this.block_counter = this.block_counter + 1;
        this.current_func.blocks.append(b);
        return b;
    }

    func lower_function(tst_node) {
        this.current_func = new CIRFunction();
        this.current_func.init(tst_node.def_id);
        
        var entry_block = this.new_block();
        
        # Traverse TST, emit flat statements into blocks
        
        return this.current_func;
    }

    func lower_method_call(block, target, receiver_type, method_name, args_list) {
        # Standard Library Ecosystem Fusing
        # Intercept high-level method calls and fuse them directly into zero-cost bytecodes
        
        if (receiver_type == "std::tensor::Tensor") {
            if (method_name == "add") {
                # Map tensor addition directly to a SIMD intrinsic instead of a function call
                block.add_intrinsic_call(target, "vec_add_4s", args_list);
                return 1;
            }
            if (method_name == "matmul") {
                # Map matrix multiplication directly to the OpenBLAS C FFI
                block.add_extern_call(target, "cblas_dgemm", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::process::Cmd") {
            if (method_name == "run") {
                # Map process spawning directly to a bare-metal OS syscall
                block.add_intrinsic_call(target, "syscall_exec", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::interop::python") {
            if (method_name == "__py_eval") {
                # Map python evaluation directly to libpython C API
                block.add_extern_call(target, "PyRun_SimpleString", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::fs::File") {
            if (method_name == "init") {
                block.add_intrinsic_call(target, "syscall_open", args_list);
                return 1;
            }
            if (method_name == "read") {
                block.add_intrinsic_call(target, "syscall_read", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::crypto::hash::Sha256") {
            if (method_name == "init") {
                block.add_extern_call(target, "crypto_hash_sha256_init", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::math") {
            if (method_name == "sin") {
                block.add_intrinsic_call(target, "fpu_sin", args_list);
                return 1;
            }
            if (method_name == "cos") {
                block.add_intrinsic_call(target, "fpu_cos", args_list);
                return 1;
            }
            if (method_name == "sqrt") {
                block.add_intrinsic_call(target, "fpu_sqrt", args_list);
                return 1;
            }
            if (method_name == "pow") {
                block.add_intrinsic_call(target, "fpu_pow", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::ptr::RawPtr") {
            if (method_name == "read_volatile") {
                block.add_intrinsic_call(target, "volatile_read", args_list);
                return 1;
            }
            if (method_name == "write_volatile") {
                block.add_intrinsic_call(target, "volatile_write", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::arch::io") {
            if (method_name == "inb") {
                block.add_intrinsic_call(target, "asm_inb", args_list);
                return 1;
            }
            if (method_name == "outb") {
                block.add_intrinsic_call(target, "asm_outb", args_list);
                return 1;
            }
        }
        
        if (receiver_type == "std::db::sql::SqlConnection") {
            if (method_name == "init") {
                # Bind to SQLite open
                block.add_extern_call(target, "sqlite3_open", args_list);
                return 1;
            }
        }
        
        return 0; # Fallback to standard function call lowering
    }
}
