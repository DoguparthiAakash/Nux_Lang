import synapse::tensor::Tensor;

class Linear {
    var weights;
    var bias;
    
    func init(in_features, out_features) {
        this.weights = new Tensor([in_features, out_features]);
        this.weights.requires_grad = 1;
        
        this.bias = new Tensor([out_features]);
        this.bias.requires_grad = 1;
    }
    
    func forward(x) {
        # Y = x * W + b
        # Under the hood, this creates a MatMulNode and AddNode in the Autograd graph
    }
}

