# std::sync::task
# Implements Structured Concurrency for Nux.
# Guarantees that spawned tasks can NEVER outlive their parent scope,
# preventing "leaked goroutine" bugs entirely at compile time.

class TaskScope {
    var handles;
    
    func init() {
        this.handles = new List();
        this.handles.init();
    }
    
    func spawn(closure) {
        # Spawns a new task bound to this scope's lifetime.
        # The Nux borrow checker guarantees that the `closure` cannot capture
        # references that outlive this scope.
    }
    
    func wait_all() {
        # Blocks until all spawned tasks complete.
        # Automatically called via RAII drop() if the scope exits early!
    }
}

func scope(block) {
    var s = new TaskScope();
    s.init();
    block(s);
    s.wait_all();
}
