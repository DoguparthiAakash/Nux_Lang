# Nux 2D Graphics Library

class Graphics {
    var width ;
    var height ;
    var fb_addr ;

    func init(w, h) {
        
            vbe_set_mode(w, h, 32);
            this.width = w;
            this.height = h;
            this.fb_addr = vbe_get_fb();
        
        return 0;
    }

    func update() {
         vbe_update(); 
        return 0;
    }

    func clear(color) {
        var i = 0;
        var total = this.width * this.height;
        
            while (i < total) {
                poke32(this.fb_addr + (i * 4), color);
                i = i + 1;
            }
        
        return 0;
    }

    func set_pixel(x, y, color) {
        if (x >= 0) {
        if (x < this.width) {
        if (y >= 0) {
        if (y < this.height) {
            
                var offset = (y * this.width) + x;
                poke32(this.fb_addr + (offset * 4), color);
            
        }
        }
        }
        }
        return 0;
    }

    func abs(n) {
        if (n < 0) {
            return 0 - n;
        }
        return n;
    }

    func draw_line(x0, y0, x1, y1, color) {
        var dx = this.abs(x1 - x0);
        var dy = 0 - this.abs(y1 - y0);
        var sx = -1;
        var sy = -1;
        if (x0 < x1) { sx = 1; }
        if (y0 < y1) { sy = 1; }
        var err = dx + dy;
        var e2 = 0;

        var cx = x0;
        var cy = y0;
        var done = 0;

        while (done == 0) {
            this.set_pixel(cx, cy, color);
            if (cx == x1) {
                if (cy == y1) {
                    done = 1;
                }
            }
            if (done == 0) {
                e2 = 2 * err;
                if (e2 >= dy) {
                    err = err + dy;
                    cx = cx + sx;
                }
                if (e2 <= dx) {
                    err = err + dx;
                    cy = cy + sy;
                }
            }
        }
        return 0;
    }

    func draw_rect(x, y, w, h, color) {
        var cx = x;
        var cy = y;
        var ex = x + w;
        var ey = y + h;

        while (cy < ey) {
            cx = x;
            while (cx < ex) {
                this.set_pixel(cx, cy, color);
                cx = cx + 1;
            }
            cy = cy + 1;
        }
        return 0;
    }
}
func gfx_set_pixel(g: Graphics, x, y, c) {
    return g.set_pixel(x, y, c);
}
func gfx_draw_rect(g: Graphics, x, y, w, h, c) {
    return g.draw_rect(x, y, w, h, c);
}
func gfx_draw_line(g: Graphics, x0, y0, x1, y1, c) {
    return g.draw_line(x0, y0, x1, y1, c);
}
func gfx_update(g: Graphics) {
    return g.update();
}
func gfx_clear(g: Graphics, c) {
    return g.clear(c);
}
