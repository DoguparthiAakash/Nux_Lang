# Small deterministic hashes for IDs, caches, and content checks.

func hash_mix(hash, value) {
    var result = hash;
    result = result * 16777619;
    result = result xor value;
    if (result < 0) {
        result = 0 - result;
    }
    return result;
}

func hash_bytes(buffer, length) {
    var index = 0;
    var hash = 2166136261;
    while (index < length) {
        hash = hash_mix(hash, mem_read8(buffer + index));
        index = index + 1;
    }
    return hash;
}

func hash_words(buffer, length) {
    var index = 0;
    var hash = 2166136261;
    while (index < length) {
        hash = hash_mix(hash, mem_read64(buffer + index * 8));
        index = index + 1;
    }
    return hash;
}
