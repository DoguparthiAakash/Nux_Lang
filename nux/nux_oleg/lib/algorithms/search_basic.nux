# Search and ordering algorithms over numeric Nux arrays.
import "std.array_basic";

func search_linear(array, length, target) {
    var index = 0;
    while (index < length) {
        if (array_get(array, index) == target) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

func search_binary(array, length, target) {
    var low = 0;
    var high = length - 1;
    var middle = 0;
    var value = 0;
    while (low <= high) {
        middle = low + (high - low) / 2;
        value = array_get(array, middle);
        if (value == target) {
            return middle;
        }
        if (value < target) {
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
    return -1;
}

func sort_selection(array, length) {
    var start = 0;
    var smallest = 0;
    var scan = 0;
    var current = 0;
    var minimum = 0;
    while (start < length) {
        smallest = start;
        scan = start + 1;
        while (scan < length) {
            if (array_get(array, scan) < array_get(array, smallest)) {
                smallest = scan;
            }
            scan = scan + 1;
        }
        current = array_get(array, start);
        minimum = array_get(array, smallest);
        array_set(array, start, minimum);
        array_set(array, smallest, current);
        start = start + 1;
    }
    return array;
}

func array_min(array, length) {
    if (length <= 0) {
        return 0;
    }
    var index = 1;
    var result = array_get(array, 0);
    while (index < length) {
        var value = array_get(array, index);
        if (value < result) {
            result = value;
        }
        index = index + 1;
    }
    return result;
}

func array_count(array, length, target) {
    var index = 0;
    var count = 0;
    while (index < length) {
        if (array_get(array, index) == target) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

func array_reduce_sum(array, length, initial) {
    var index = 0;
    var result = initial;
    while (index < length) {
        result = result + array_get(array, index);
        index = index + 1;
    }
    return result;
}
